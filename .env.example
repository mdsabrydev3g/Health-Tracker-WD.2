# Health Tracker — Environment Variables
# Copy this file to .env.local and fill in your values.

# ------------------------------------------------------------------
# Neon Postgres (required for sync + backup)
# Get your connection string from: https://console.neon.tech
# ------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ------------------------------------------------------------------
# OpenAI (required for AI lab summarisation + medication scan)
# Keep this server-side only — never expose in client bundles.
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------
# Backup cron secret (required for /api/backup)
# Set a long random string. The cron job sends it as x-backup-secret.
# ------------------------------------------------------------------
BACKUP_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------------
# Firebase (optional — kept for backward compatibility)
# If set, the app can also sync to Firestore alongside Neon.
# If unset, the app runs 100% offline with local IndexedDB.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# Cloud Functions base URL (optional)
# Points to your Vercel deployment or Firebase Functions.
# Example: https://health-tracker.vercel.app/api
# ------------------------------------------------------------------
VITE_FUNCTIONS_BASE_URL=
